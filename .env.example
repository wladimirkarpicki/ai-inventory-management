# Copy to .env and fill in. compose.yml reads these values.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection used by compose.yml.
DATABASE_NAME=inventory
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Inside Docker Compose the database service is named "db".
# For local development without Docker use: localhost, with
# DATABASE_PORT=5433 because the db service publishes 127.0.0.1:5433.
DATABASE_HOST=db
DATABASE_PORT=5432