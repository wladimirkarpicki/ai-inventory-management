# Copy to .env and fill in real values. NEVER commit the real .env file.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"

# --- Application ---
# Required, >= 32 chars; used to sign bearer tokens.
SECRET_KEY=

# --- PostgreSQL ---
# Inside the docker network the service name is `db`. The db service also
# publishes 127.0.0.1:5433 -> 5432, so a locally run `uvicorn main:app`
# and the pytest suite reach the SAME database the app uses. Point
# DATABASE_PORT at that published port to keep one authoritative database
# instead of two copies that drift apart.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=inventory
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Opt-in monitoring stack (docker compose --profile monitoring up) ---
# Grafana admin password — change it before exposing the port.
GRAFANA_ADMIN_PASSWORD=admin

# --- NVIDIA Build API (for /api/forecast) ---
# Optional: without a key the forecast still runs on regression alone.
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
