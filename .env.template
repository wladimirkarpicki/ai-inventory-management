# Copy to .env and fill in real values. NEVER commit the real .env file.

This is the single source of truth for environment variables. `.env.example`
is a pointer to this file, so the two cannot drift apart again.

Every variable below is read either by main.py, by database.py, or by
compose.yml. Nothing here is decorative: if you delete a line, something
stops reading it.

# --- Application ---
# Required, >= 32 chars; used to sign bearer tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- PostgreSQL ---
# The Compose service is named `db`. Inside the Docker network you normally
# leave this as `db` and never set it at all, because compose.yml passes
# DATABASE_HOST=db to the app container directly.
#
# For a database running outside Docker, use `localhost` (and
# DATABASE_PORT=5432, the default). Note that the compose `db` service
# deliberately publishes NO port to the host, so there is nothing to
# point at from outside; read it with:
#     docker compose exec db psql -U "$DATABASE_USER" "$DATABASE_NAME"
#
# DATABASE_PORT is optional and defaults to 5432 when unset.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=inventory
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Opt-in monitoring stack (docker compose --profile monitoring up) ---
# Grafana admin password — change it before exposing the port.
GRAFANA_ADMIN_PASSWORD=admin

# --- NVIDIA Build API (for /api/forecast) ---
# Optional: without a key the forecast still runs on regression alone.
# Get a key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# --- LLM tuning (optional) ---
# Socket timeout in seconds for the NVIDIA call. Defaults to 240; the request
# path is bounded by LLM_TIMEOUT + 5s of grace either way, and an unparsable
# value falls back to the default instead of failing startup.
LLM_TIMEOUT=240
