# Copy to .env and fill in real values. NEVER commit the real .env file.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"

# --- Application ---
# Required, >= 32 chars; used to sign bearer tokens.
SECRET_KEY=

# --- PostgreSQL ---
# Compose service name is `db`; for local (non-docker) runs use localhost.
DATABASE_HOST=localhost
DATABASE_NAME=inventory
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Opt-in monitoring stack (docker compose --profile monitoring up) ---
# Grafana admin password — change it before exposing the port.
GRAFANA_ADMIN_PASSWORD=admin
